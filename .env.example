# Application
NODE_ENV=development
PORT=3000
HOST=localhost

# LLM Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_CONTEXT_LENGTH=2048

# Search Configuration
SEARCH_PROVIDER=searxng_local
SEARXNG_URL=http://localhost:8888
SEARCH_TIMEOUT=10000

# Memory Database
MEMORY_DB=sqlite
MEMORY_DB_PATH=./memory_db/rei.db

# TTS (Text-to-Speech)
TTS_ENGINE=piper
TTS_VOICE=rei_jp
TTS_SPEED=1.0

# Avatar
AVATAR_SYSTEM=live2d
AVATAR_MODEL=rei_default

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/system.log

# Security
QR_EXPIRY_MINUTES=10
SESSION_TIMEOUT_MINUTES=1440

# Features
ENABLE_WEB_SEARCH=true
ENABLE_AUTO_MEMORY=true
ENABLE_EMOTION_DISPLAY=true
ENABLE_VOICE=true
ENABLE_LIP_SYNC=true
