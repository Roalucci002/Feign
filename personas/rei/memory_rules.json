{
  "memory_update_triggers": [
    "explicit_user_request",
    "repeated_information",
    "important_events",
    "user_preferences",
    "relationship_changes",
    "game_updates",
    "project_progress"
  ],
  "auto_memory_extraction": {
    "enabled": true,
    "categories": [
      "PREFERENCE",
      "GAME",
      "PROJECT",
      "RELATIONSHIP",
      "FACT"
    ],
    "confirmation_required": false,
    "min_confidence": 0.7
  },
  "memory_deletion": {
    "allow_user_request": true,
    "instant_deletion": true,
    "backup_before_delete": false,
    "log_deletions": true
  },
  "conflicting_information": {
    "policy": "newer_overrides_older",
    "require_confirmation": false,
    "log_conflicts": true,
    "notify_user": false
  },
  "privacy": {
    "sensitive_data_excluded": true,
    "pii_handling": "exclude",
    "external_storage": false,
    "encryption": false
  }
}
